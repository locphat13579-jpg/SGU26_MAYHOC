    "import torch\n",
    "\n",
    "X = torch.arange(24)\n",
    "\n",
    "X_4x6 = X.reshape(4, 6)\n",
    "X_2x12 = X.reshape(2, 12)\n",
    "X_2x3x4 = X.reshape(2, 3, 4)\n",
    "\n",
    "print(\"--- Yêu cầu 1 ---\")\n",
    "print(\"4x6:\\n\", X_4x6)\n",
    "print(\"2x12:\\n\", X_2x12)\n",
    "print(\"2x3x4:\\n\", X_2x3x4)\n",
    "\n",
    "\n",
    "A = torch.randn(3, 4)\n",
    "B = torch.randn(3, 4)\n",
    "\n",
    "add_res = A + B\n",
    "mul_res = A * B\n",
    "div_res = A / B\n",
    "\n",
    "mean_col_A = torch.mean(A, dim=0)\n",
    "std_col_A = torch.std(A, dim=0)\n",
    "\n",
    "mean_col_B = torch.mean(B, dim=0)\n",
    "std_col_B = torch.std(B, dim=0)\n",
    "\n",
    "print(\"\\n--- Yêu cầu 2 ---\")\n",
    "print(\"A + B:\\n\", add_res)\n",
    "print(\"A * B:\\n\", mul_res)\n",
    "print(\"A / B:\\n\", div_res)\n",
    "print(\"Trung bình theo cột A:\", mean_col_A)\n",
    "print(\"Độ lệch chuẩn theo cột A:\", std_col_A)\n",
    "\n",
    "\n",
    "x = torch.tensor(2.0, requires_grad=True)\n",
    "y = 2 * x**2 + 5 * x + 3\n",
    "y.backward()\n",
    "\n",
    "print(\"\\n--- Yêu cầu 3 ---\")\n",
    "print(\"dy/dx bằng autograd:\", x.grad.item())\n",
    "\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "polynomial = np.poly1d([2, -3, 5])\n",
    "N = 20\n",
    "\n",
    "X_data = np.random.randn(N, 1) * 5\n",
    "Y_data = polynomial(X_data)\n",
    "\n",
    "XX = np.hstack([\n",
    "    X_data * X_data,\n",
    "    X_data,\n",
    "    np.ones_like(X_data)\n",
    "])\n",
    "\n",
    "w = torch.randn(3, 1, requires_grad=True)\n",
    "x_poly = torch.tensor(XX, dtype=torch.float32)\n",
    "y_poly = torch.tensor(Y_data, dtype=torch.float32)\n",
    "\n",
    "optimizer = torch.optim.NAdam([w], lr=0.01)\n",
    "\n",
    "for epoch in range(1500):\n",
    "    optimizer.zero_grad()\n",
    "    y_pred = x_poly @ w\n",
    "    mse = torch.mean(torch.square(y_poly - y_pred))\n",
    "    mse.backward()\n",
    "    optimizer.step()\n",
